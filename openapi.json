                    "message": {
                      "type": "string",
                      "example": "Retrieved hall of fame entry"
                    },
                    "count": {
                      "type": "number",
                      "example": 1
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/hof"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
