        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "league": {
            "type": "string"
          },
          "founded": {
            "type": "integer"
          },
          "achievements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
